# Production defaults. One process owns all room state.
# npm scripts do not load .env automatically.
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
MAX_CONNECTIONS=256
MAX_CONNECTIONS_PER_IP=32
MAX_ROOMS=32
MAX_ROOMS_PER_IP=8
# Enable only behind a trusted proxy with no direct public access to PORT.
TRUST_PROXY=0
# Optional extra exact browser origins, comma-separated. Same host is allowed.
ALLOWED_ORIGINS=
