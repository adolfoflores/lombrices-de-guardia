{
  "name": "lombrices-de-guardia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node server/index.js",
    "build": "node scripts/build.js",
    "start": "node server/start.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-test.js",
    "check": "node scripts/check.js",
    "lint": "eslint . --max-warnings=0",
    "check:toolchain": "node scripts/toolchain.js",
    "check:secrets": "gitleaks git --redact --log-opts=--all .",
    "test:presentation": "node scripts/presentation-smoke.js",
    "test:pixi": "node scripts/pixi-smoke.js",
    "test:identity": "node scripts/identity-smoke.js",
    "test:terrain": "node scripts/terrain-smoke.js",
    "test:biomes": "node scripts/biomes-smoke.js",
    "test:soak": "node scripts/soak.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check:toolchain && npm run check && npm run lint && npm run format:check && npm run licenses:check && npm run build && npm test",
    "test:unit": "node scripts/test-unit.js",
    "test:security": "node --test tests/server-safety.test.js tests/transport.test.js",
    "test:release": "npm run verify && npm run test:simulation && npm run test:browser:all",
    "test:browser:all": "node scripts/browser-matrix.js",
    "test:simulation": "node scripts/simulation-benchmark.js",
    "art:optimize": "node scripts/optimize-art.js",
    "licenses": "node scripts/licenses.js",
    "licenses:check": "node scripts/licenses.js --check"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "ws": "^8.18.3"
  },
  "overrides": {
    "eslint@10.13.0": {
      "minimatch": "11.0.4"
    }
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "vite": "^7.3.8",
    "prettier": "3.9.10",
    "eslint": "10.15.0",
    "globals": "17.14.0"
  },
  "license": "MIT",
  "description": "Artillería web por turnos para 2–6 personas en salas privadas."
}
